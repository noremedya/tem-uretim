# Tem Motor Üretim — üretim ortamı değişkenleri (docker-compose.prod.yml).
# Kopyalayın:  cp .env.production.example .env  &&  chmod 600 .env
# Güncel kopyasını şifre yöneticisinde saklayın (KURULUM_KILAVUZU bölüm 14).
#
# Sabit ayarlar (dil, saat dilimi, kuyruk/önbellek/oturum sürücüsü, DB_HOST vb.) compose dosyasındadır;
# burada yalnızca kuruluma özgü değerler ve gizli bilgiler bulunur. Değişiklikten sonra servisleri
# yenileyin: dc up -d

# --- Uygulama ---------------------------------------------------------------------------------
# Uygulamanın (menü başlığı, tarayıcı sekmesi) ve firmanın adı (etiketler). Her firmaya ayrı kurulumda değişir.
APP_NAME="Tem Motor Üretim"
COMPANY_NAME="TEM MOTOR"
# Panel logosu, uzantısız: public/ altındaki <ad>.svg ve <ad>-dark.svg; sekme simgesi -logo yerine -icon.
# Başka firma kurulumunda değiştirin; boş bırakılırsa uygulama adı yazı olarak görünür.
BRAND_LOGO=images/tem-uretim-logo
# Ortam: production (gerçek kullanım) veya demo (örnek verilerle tanıtım sunucusu, ekranda "DEMO" uyarısı;
# KURULUM_KILAVUZU bölüm 16). Gerçek kullanıma geçerken demo veritabanı silinir, production ile yeniden kurulur.
APP_ENV=production
# Yalnızca demo: demo kullanıcılarının şifresi (en az 10 karakter). production'da boş bırakın.
DEMO_PASSWORD=
# Şifreleme anahtarı. İlk kurulumda üretilir ve bir daha DEĞİŞTİRİLMEZ (değişirse oturumlar ve
# şifrelenmiş veriler açılamaz):  dc run --rm app php artisan key:generate --show
APP_KEY=
# Kullanıcıların tarayıcıda açtığı adres (https ile).
APP_URL=https://uretim.alanadi.com
# Log ayrıntısı: debug, info, warning, error. Loglar: dc logs app (worker, scheduler)
LOG_LEVEL=info

# --- Veritabanı -------------------------------------------------------------------------------
# Şifreleri şu komutla üretin: openssl rand -hex 24
# Yalnızca harf ve rakam kullanın: $, tırnak ve boşluk compose tarafından farklı yorumlanır.
DB_DATABASE=uretim
# Tablo sahibi: migration, yedek ve geri yükleme bu kullanıcıyla yapılır. Bu bilgiler yalnızca
# veritabanı konteynerine ve betiklere verilir, uygulamaya verilmez. İlk kurulumdan sonra
# kullanıcı adı ve şifre burada değiştirilirse veritabanındaki değer değişmez (PostgreSQL ilk
# açılışta oluşturur); şifre değişikliği için: dc exec db psql -U uretim -c "\password uretim"
DB_OWNER_USERNAME=uretim
DB_OWNER_PASSWORD=UZUN_RASTGELE_SIFRE_1
# Uygulama kullanıcısı: tablo sahibi değildir, yalnızca veri okuyup yazar (deploy/db/app-role.sql).
# Kullanıcı ve şifre deploy.sh / db-migrate.sh her çalıştığında bu değerlere göre ayarlanır.
DB_USERNAME=uretim_app
DB_PASSWORD=UZUN_RASTGELE_SIFRE_2

# --- Muhasebe ---------------------------------------------------------------------------------
# Dövizli faturada kullanılan TCMB kuru: forex_selling (döviz satış, varsayılan) veya forex_buying
# (döviz alış). Mali müşavirle teyit edilecek (CLAUDE.md bölüm 5 "Kur").
INVOICE_RATE_TYPE=forex_selling

# --- HTTPS (Caddy) ----------------------------------------------------------------------------
# Uygulamanın alan adı; yerel DNS bu adı sunucunun IP'sine çözer (KURULUM_KILAVUZU bölüm 9).
APP_DOMAIN=uretim.alanadi.com
# Cloudflare API token ("Edit zone DNS", yalnızca bu alan adı). Caddy sertifikayı DNS doğrulamasıyla alır.
CF_API_TOKEN=

# --- Dışarıdan erişim (Cloudflare Tunnel) -----------------------------------------------------
# İsteğe bağlı. Yalnızca fabrika içi ağda (intranet) kullanımda boş bırakın; tünel servisi başlamaz.
# Açmak için: Zero Trust → Networks → Tunnels'da verilen token'ı yazın ve ayrıca şu satırı ekleyin:
#   COMPOSE_PROFILES=tunnel
# (KURULUM_KILAVUZU bölüm 11).
TUNNEL_TOKEN=

# Ürün deposu: reçetedeki her ürün kendi deposunu alır. Tem Motor'da açık. Değiştirmeden önce KURULUM_KILAVUZU.md'ye bakın.
STOCK_PART_WAREHOUSES=true
